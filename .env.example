# Copy this file to .env and fill in your own values. Never commit .env.
# The key is read on the server only and is never sent to the browser.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# LLM_PROVIDER=gemini            # or "anthropic" (then set ANTHROPIC_API_KEY instead)
# MODEL=gemini-3.5-flash-lite
# CLASSIFIER_MODEL=gemini-3.5-flash-lite
# THINKING_LEVEL=                # gemini only: minimal | low | medium | high. Empty = model default
# PRODUCT_NAME=OpBritops
# HOST=127.0.0.1
# PORT=3000
# MAX_INPUT_CHARS=1000
# MAX_HISTORY_MESSAGES=12
# MAX_OUTPUT_TOKENS=600
# RATE_PER_MINUTE=15
# DAILY_REQUEST_CAP=2000
