# Copy this file to .env and fill in your own values. Never commit .env.
# The key is read on the server only and is never sent to the browser.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# LLM_PROVIDER=gemini            # or "anthropic" (then set ANTHROPIC_API_KEY instead)
# MODEL=gemini-3.5-flash-lite
# CLASSIFIER_MODEL=gemini-3.5-flash-lite
# THINKING_LEVEL=                # gemini only: minimal | low | medium | high. Empty = model default
# PRODUCT_NAME=OpBritops
# HOST=127.0.0.1
# PORT=3000
# MAX_INPUT_CHARS=1000
# MAX_HISTORY_MESSAGES=12
# MAX_OUTPUT_TOKENS=600
# RATE_PER_MINUTE=15
# DAILY_REQUEST_CAP=2000
# PER_CLIENT_DAILY_CAP=200       # requests one IP may make per UTC day (stops one client using up DAILY_REQUEST_CAP)
# TRUST_PROXY_HOPS=0             # number of reverse proxies in front of the app; 0 = ignore X-Forwarded-For
# ALLOWED_HOSTS=                 # comma-separated Host names; default on 127.0.0.1 is localhost,127.0.0.1,[::1]; empty on other HOSTs = no check
